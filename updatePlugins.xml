<?xml version="1.0" encoding="UTF-8"?>
<!--
  自定义插件仓库（Custom Plugin Repository）描述文件。

  IDE 通过它判断"有没有更新"：
    设置 → 插件 → ⚙️ → 管理插件仓库… → 添加本文件的 URL：
    https://raw.githubusercontent.com/JiangWanZhengChouYv/ClionLuogu/main/updatePlugins.xml

  约束（JetBrains 官方规定）：
    - id / version 必须与构建产物 META-INF/plugin.xml 中的值完全一致
    - <idea-version> 也必须与产物一致（本插件构建后为 since-build="243"，无 until-build）
    - url 必须是 HTTPS 且直接指向插件 zip

  本文件由 scripts/release.sh 在发版时自动重建 plugin 元素（id / url / version / 名称 / 描述 / 变更说明），
  一般不需要手改。
-->
<plugins>
    <plugin
          id="com.jiangwanzhengchouyv.clionluogu"
          url="https://cdn.jsdelivr.net/gh/JiangWanZhengChouYv/ClionLuogu@v1.3.2/dist/ClionLuogu-1.3.2.zip"
          version="1.3.2">
    <idea-version since-build="243" />
    <name>ClionLuogu</name>
    <description><![CDATA[在 CLion 里一站式刷洛谷：拉题、预览、提交、看评测。<br/>
<ul>
  <li>拉取题目与全部样例，生成 .cpp / .md / samples</li>
  <li>搜索题目，双击结果即可预览题面（LaTeX 公式与图片）</li>
  <li>一键提交当前代码，自动轮询评测结果</li>
  <li>评测详情按子任务展示逐测试点彩色方块（悬停看耗时 / 内存）</li>
  <li>提交记录按项目持久化（含源码），可查看 / 复制当次代码</li>
</ul>
非官方工具：仅使用你自己的登录态，不会自动登录、不会绕过验证码。]]></description>
    <change-notes><![CDATA[<b>1.3.2</b>：完善自定义插件仓库的元数据——插件仓库列表现在会显示插件描述与本版更新说明（功能与 1.3.1 相同，仅为更新通道可用）]]></change-notes>
  </plugin>
</plugins>
